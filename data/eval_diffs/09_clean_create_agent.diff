+"""요약 체인과 리뷰 에이전트.
+
+교육용 더미 데이터입니다 (CiteReview 평가 케이스 09).
+LangChain 1.x 권장 API(create_agent, LCEL)만 사용한다.
+"""
+
+from __future__ import annotations
+
+from langchain.agents import create_agent
+from langchain_aws import ChatBedrockConverse
+from langchain_core.output_parsers import StrOutputParser
+from langchain_core.prompts import ChatPromptTemplate
+from langchain_core.tools import tool
+
+MODEL_ID = "us.anthropic.claude-haiku-4-5-20251001-v1:0"
+SUMMARY_PROMPT = ChatPromptTemplate.from_template(
+    "다음 리뷰를 세 줄로 요약해 주세요:\n{review}"
+)
+
+
+@tool
+def count_lines(code: str) -> int:
+    """코드의 줄 수를 센다."""
+    return len(code.splitlines())
+
+
+def get_model(model_id: str = MODEL_ID) -> ChatBedrockConverse:
+    """리뷰 모델을 만든다."""
+    return ChatBedrockConverse(model=model_id, temperature=0)
+
+
+def build_summary_chain(model):
+    """LCEL 요약 체인을 만든다."""
+    return SUMMARY_PROMPT | model | StrOutputParser()
+
+
+def build_review_agent(model):
+    """줄 수 도구를 쓰는 리뷰 에이전트를 만든다."""
+    return create_agent(
+        model=model,
+        tools=[count_lines],
+        system_prompt="너는 친절한 코드 리뷰어다.",
+    )
