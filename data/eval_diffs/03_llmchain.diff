+"""요약 체인 모듈.
+
+교육용 더미 데이터입니다 (CiteReview 평가 케이스 03).
+사용자가 붙여 넣은 글을 세 문장으로 요약하는 체인을 만든다.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Any
+
+from langchain.chains import LLMChain
+from langchain_aws import ChatBedrockConverse
+from langchain_core.prompts import PromptTemplate
+
+DEFAULT_MODEL = "us.anthropic.claude-haiku-4-5-20251001-v1:0"
+PROMPT = PromptTemplate.from_template(
+    "다음 글을 세 문장으로 요약해 주세요:\n\n{text}"
+)
+
+
+def build_chain(model_id: str | None = None) -> LLMChain:
+    """요약 체인을 만든다."""
+    model = model_id or os.environ.get("SUMMARY_MODEL", DEFAULT_MODEL)
+    llm = ChatBedrockConverse(model=model, temperature=0)
+    return LLMChain(llm=llm, prompt=PROMPT)
+
+
+def summarize(text: str, **kwargs: Any) -> str:
+    """글을 요약해 문자열로 돌려준다."""
+    chain = build_chain(**kwargs)
+    return chain.run(text=text)
